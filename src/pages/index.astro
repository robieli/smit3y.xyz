---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadResearchEntries } from "../lib/research";
import smit3yImage from "../assets/smit3y.jpg";
import LetterGlitch from "../components/LetterGlitchWaves.tsx";
import AboutCarousel from "../components/AboutCarousel.astro";
import NumberRain from "../components/NumberRain.astro";

const heroTitle = "SMIT3Y.XYZ";
// Splits a heading into words for the kinetic scroll-reveal treatment —
// each word gets its own [data-reveal] + --i so they cascade in on scroll
// (reuses the same reveal mechanism as everything else, see global.css).
const kineticWords = (text: string) => text.split(" ");
const researchEntries = loadResearchEntries();
const featuredResearchEntries = researchEntries.slice(0, 6);
const experienceEntries = [
  {
    period: "PRESENT",
    role: "Sales, Trading & Prime Brokerage Intern",
    organization: "Coinbase",
    organizationUrl: "https://www.coinbase.com",
    bullets: [
      "Working closely on navigating sales, custodial, and staking requests from clients inspired to get involved with the digital asset space",
    ],
  },
  {
    period: "SUMMER 2025",
    role: "Wealth Management Intern",
    organization: "Dyer Wealth Management - San Diego, CA",
    bullets: [
      "Assisted in portfolio construction, backtesting financial models and algorithms, and client advisory across equity and fixed-income allocations.",
    ],
  },
  {
    period: "2023 - PRESENT",
    role: "Practice Player",
    organization: "University of Michigan Women's Basketball",
    bullets: [
      "Selected as a practice player to train with the University of Michigan's Division I basketball team, making me a further fan of the WNBA and women's college basketball",
    ],
  },
  {
    period: "2023 - PRESENT",
    role: "Co-Founder",
    organization: "S&Y Scholars - College Consulting",
    bullets: [
      "Co-founded a peer-to-peer college admissions consulting service helping families navigate recruitment and strategy.",
      "Read more on how you can use our services below",
      "Winner of the 2023 New York Times College Essay Challenge",
    ],
  },
];
const snyStats = [
  { value: "75%+", label: "Success Rate", detail: "Across all schools applied" },
  { value: "37", label: "Schools Applied" },
  { value: "1570", label: "Combined SAT" },
  { value: "4.7", label: "Combined GPA" },
];
const snyServices = [
  {
    title: "Interview & Resume Guidance",
    description:
      "Real-time consultation leveraging our personal experiences. Personalized strategy tailored to each student's aspirations.",
    icon: "microphone",
  },
  {
    title: "Essay Editing",
    description:
      "Refining application essays to showcase your unique strengths. We translate your voice directly onto paper.",
    icon: "pen",
  },
  {
    title: "Application Strategy",
    description: "Expert advice on school selection, timelines, and standing out.",
    icon: "target",
  },
];
const snyFounders = [
  {
    name: "Samuel Smith",
    school: "University of Michigan - Economics & Psychology",
    bio: "Junior at U of M, practice player on the Women's Basketball team, avid chess player, and winner of the 2023 New York Times College Essay Challenge.",
    linkedin: "https://www.linkedin.com/in/ssam-smith/",
  },
  {
    name: "Richard Yoon",
    school: "Columbia University - Dual Degree with Sciences Po",
    bio: "Junior at Columbia, spent first two years in Reims, France through the dual-degree program. Avid basketball player, 10+ years of robotics experience, and former Co-President of Mock Trial at La Jolla High.",
    linkedin: "https://www.linkedin.com/in/yoonrichard/",
  },
];
---

<BaseLayout title="smit3y.xyz" fullBleed={true}>
  <section id="home" class="home-section" aria-label="Home">
    <div class="hero-backdrop" aria-hidden="true">
      <LetterGlitch
        client:load
        glitchSpeed={50}
        centerVignette={false}
        outerVignette={false}
        smooth={true}
        waveCurvature={50}
        waveWavelength={1400}
        waveBandThickness={200}
        waveAngleDeg={55}
      />
      <div class="hero-fade-bottom"></div>
    </div>
    <div class="hero-content">
      <p class="hero-typewriter" aria-hidden="true" data-typewriter="&gt; whoami"></p>
      <h1
        class="hero-title magnetic"
        id="hero-title"
        aria-label={heroTitle}
        data-magnetic-strength="0.16"
        data-magnetic-max="32"
      >
        <span aria-hidden="true">
          {
            heroTitle.split("").map((ch, i) => (
              <span class="hero-letter" data-char={ch} style={`--i: ${i}`}>
                {ch}
              </span>
            ))
          }
        </span>
      </h1>
      <div class="hero-actions" aria-label="Featured actions">
        <a class="hero-action hero-action-primary magnetic" href="#research">
          VIEW RESEARCH <span aria-hidden="true">→</span>
        </a>
        <a class="hero-action hero-action-secondary magnetic" href="#about">ABOUT ME</a>
      </div>
    </div>
    <a class="scroll-cue" href="#about" aria-label="Scroll to about section">
      <span>SCROLL TO EXPLORE</span>
      <span aria-hidden="true">⌄</span>
    </a>
  </section>
  <section id="about" class="about-section" aria-label="About">
    <NumberRain side="left" />
    <NumberRain side="right" />
    <div class="about-shell">
      <p class="about-kicker" data-reveal>// ABOUT</p>
      <h2 class="about-title">
        {
          kineticWords("Who Am I").map((word, i) => (
            <span class="kinetic-word" data-reveal style={`--i: ${i}`}>
              {word}
            </span>
          ))
        }
      </h2>
      <div class="about-socials" data-reveal style="--i: 3">
        <a
          class="about-social-link magnetic"
          href="https://www.linkedin.com/in/ssam-smith/"
          target="_blank"
          rel="noopener noreferrer me"
          data-magnetic-strength="0.25"
          data-magnetic-max="8"
        >
          <span class="about-social-link__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
              <path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 7c1.12 0 1.87-.75 1.87-1.75C7.12 4.25 6.37 3.5 5.25 3.5 4.13 3.5 3.38 4.25 3.38 5.25 3.38 6.25 4.13 7 5.25 7ZM20.44 20h-3.38v-6.13c0-1.5-.53-2.5-1.87-2.5-1.02 0-1.63.69-1.9 1.35-.1.24-.12.58-.12.92V20h-3.38s.05-10.44 0-11.5h3.38v1.63c.45-.7 1.25-1.7 3.04-1.7 2.22 0 3.88 1.45 3.88 4.56V20Z" />
            </svg>
          </span>
          LinkedIn
        </a>
        <a
          class="about-social-link magnetic"
          href="https://x.com/smit3y_"
          target="_blank"
          rel="noopener noreferrer me"
          data-magnetic-strength="0.25"
          data-magnetic-max="8"
        >
          <span class="about-social-link__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
              <path d="M13.6 10.6 20.4 3h-1.9l-5.6 6.6L8.3 3H3l7.1 10.1L3 21h1.9l6-7 5.1 7H21l-7.4-10.4Zm-2.1 2.5-.7-1L5.3 4.4h2.1l4.4 6.3.7 1 5.8 8.2h-2.1l-4.7-6.7Z" />
            </svg>
          </span>
          X
        </a>
      </div>
      <div class="about-content">
        <div class="about-aside">
          <div class="about-image-wrapper">
            <img src={smit3yImage.src} alt="Eli Robinson" class="about-image" />
          </div>
          <AboutCarousel />
        </div>
        <div class="about-text">
          <p class="about-paragraph about-paragraph-lead" data-reveal style="--i: 0">
            I am a builder, basketball player, and researcher based out of New
            York City.
          </p>
          <p class="about-paragraph" data-reveal style="--i: 1">
            My passion lies in studying digital assets, macro trends, finding
            gems amongst equities, and debating with friends about our
            ever-moving world.
          </p>
          <p class="about-paragraph" data-reveal style="--i: 2">
            I study Economics and Psychology at the University of Michigan,
            Class of 2027.
          </p>
          <p class="about-paragraph" data-reveal style="--i: 3">
            I have lived in San Diego (where I am from) — Cairo, Egypt —
            Singapore — Chengdu, China — and Ann Arbor, Michigan.
          </p>
          <p class="about-paragraph" data-reveal style="--i: 4">
            I am an avid Cavaliers fan, an annoying Michigan sports fan, an
            enormous Chinatown eater, a bigger podcast listener, and an aspiring
            runner.
          </p>
          <p class="about-paragraph" data-reveal style="--i: 5">
            Doing research is what I find joy in, and participating in the most
            competitive probability game known as the United States Capital
            Markets is what I find myself doing most of the week.
          </p>
          <p class="about-paragraph" data-reveal style="--i: 6">
            My close friends call me Smitty, and that is where I have derived
            the name for this website.
          </p>
          <div class="about-signoff" data-reveal style="--i: 7">
            <p class="about-signoff__welcome">Welcome to</p>
            <p class="about-signoff__line">
              <span class="about-signoff__prompt" aria-hidden="true">&gt;</span>
              <span
                class="about-signoff__mark magnetic"
                id="about-signoff"
                aria-label="smit3y.xyz"
                data-magnetic-strength="0.3"
                data-magnetic-max="10"
              >
                <span aria-hidden="true">
                  {
                    "smit3y.xyz".split("").map((ch, i) => (
                      <span class="about-signoff__letter" data-char={ch} style={`--i: ${i}`}>
                        {ch}
                      </span>
                    ))
                  }
                </span>
              </span>
              <span class="about-signoff__cursor" aria-hidden="true"></span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section id="research" class="research-section" aria-label="Research">
    <NumberRain side="left" />
    <NumberRain side="right" />
    <div class="research-header">
      <p class="section-kicker" data-reveal>// RESEARCH</p>
      <h2>
        {
          kineticWords("Investment Theses").map((word, i) => (
            <span class="kinetic-word" data-reveal style={`--i: ${i}`}>
              {word}
            </span>
          ))
        }
      </h2>
      <p data-reveal style="--i: 2">
        I like to research beaten-down equities, trends I believe in and am
        invested in, digital assets, and decentralized finance. My work is
        published below:
      </p>
    </div>
    <div class="research-grid">
      {
        featuredResearchEntries.map((entry, index) => (
          <a
            class="research-card glow-card"
            href={`/research/${entry.slug}`}
            data-reveal
            style={`--i: ${index}`}
          >
            <span class="research-card-label">
              {entry.stockLabel || entry.title.split(" ")[0]}
            </span>
            <span class="research-card-title">{entry.title}</span>
            <span class="research-card-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>
    <div class="research-actions">
      <a class="research-see-all magnetic" href="/research">See All</a>
    </div>
  </section>
  <section id="experience" class="experience-section" aria-label="Experience">
    <NumberRain side="left" />
    <NumberRain side="right" />
    <div class="experience-shell">
      <div class="experience-header">
        <p class="section-kicker" data-reveal>// EXPERIENCE</p>
        <h2>
          {
            kineticWords("Where I've Worked").map((word, i) => (
              <span class="kinetic-word" data-reveal style={`--i: ${i}`}>
                {word}
              </span>
            ))
          }
        </h2>
      </div>
      <div class="experience-timeline">
        {
          experienceEntries.map((entry) => (
            <article class="experience-item glow-card">
              <p class="experience-period">{entry.period}</p>
              <h3 class="experience-role">{entry.role}</h3>
              {entry.organization && entry.organizationUrl && (
                <a
                  class="experience-organization experience-organization--link"
                  href={entry.organizationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {entry.organization}
                </a>
              )}
              {entry.organization && !entry.organizationUrl && (
                <p class="experience-organization">{entry.organization}</p>
              )}
              <ul class="experience-points">
                {entry.bullets.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section id="sny" class="sny-section" aria-label="S and Y Scholars">
    <NumberRain side="left" />
    <NumberRain side="right" />
    <div class="sny-shell">
      <header class="sny-header">
        <h2>
          {
            kineticWords("S&Y Scholars").map((word, i) => (
              <span class="kinetic-word" data-reveal style={`--i: ${i}`}>
                {word}
              </span>
            ))
          }
        </h2>
        <p data-reveal style="--i: 1">
          Guidance from students who were in your shoes yesterday. Peer-to-peer
          college admissions consulting.
        </p>
        <a
          class="sny-award magnetic"
          href="https://www.nytimes.com/2023/12/16/your-money/college-essays-money.html"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style="--i: 2"
          data-magnetic-strength="0.2"
          data-magnetic-max="8"
        >
          <span class="sny-award__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <path
                d="M7 4h10v3a5 5 0 0 1-10 0V4Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path
                d="M7 5H4a3 3 0 0 0 3 4M17 5h3a3 3 0 0 1-3 4"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
              <path
                d="M12 12v3.5M9.5 19.5h5M10.5 15.5h3v4h-3v-4Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          Featured in The New York Times — Winner, 2023 College Essay Challenge
          <span class="sny-award__arrow" aria-hidden="true">→</span>
        </a>
      </header>

      <div class="sny-stats" aria-label="S and Y Scholars results">
        {
          snyStats.map((stat, index) => (
            <article
              class:list={["sny-stat-card", "glow-card", index === 0 && "sny-stat-card--featured"]}
              data-reveal
              style={`--i: ${index}`}
            >
              <p class="sny-stat-value" data-count={stat.value}>0</p>
              <p class="sny-stat-label">{stat.label}</p>
              {stat.detail && <p class="sny-stat-detail">{stat.detail}</p>}
            </article>
          ))
        }
      </div>

      <div class="sny-services">
        <p class="section-kicker" data-reveal>// SERVICES</p>
        <h3>
          {
            kineticWords("What We Offer").map((word, i) => (
              <span class="kinetic-word" data-reveal style={`--i: ${i}`}>
                {word}
              </span>
            ))
          }
        </h3>
        <div class="sny-services-grid">
          {
            snyServices.map((service, index) => (
              <article class="sny-service-card glow-card" data-reveal style={`--i: ${index}`}>
                <span class="sny-service-icon" aria-hidden="true">
                  {service.icon === "microphone" && (
                    <svg viewBox="0 0 24 24" fill="none" focusable="false">
                      <path
                        d="M12 3a3 3 0 0 1 3 3v5a3 3 0 1 1-6 0V6a3 3 0 0 1 3-3Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M6.5 10.5a5.5 5.5 0 0 0 11 0M12 16v4M9 20h6"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  {service.icon === "pen" && (
                    <svg viewBox="0 0 24 24" fill="none" focusable="false">
                      <path
                        d="m4 20 4-1 10-10-3-3L5 16l-1 4Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="m13 6 3 3M4 20l4-4"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  {service.icon === "target" && (
                    <svg viewBox="0 0 24 24" fill="none" focusable="false">
                      <circle
                        cx="12"
                        cy="12"
                        r="8"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <circle
                        cx="12"
                        cy="12"
                        r="4"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <circle cx="12" cy="12" r="1.2" fill="currentColor" />
                    </svg>
                  )}
                </span>
                <h4>{service.title}</h4>
                <p>{service.description}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div class="sny-team">
        <p class="section-kicker" data-reveal>// TEAM</p>
        <h3>
          {
            kineticWords("Meet the Founders").map((word, i) => (
              <span class="kinetic-word" data-reveal style={`--i: ${i}`}>
                {word}
              </span>
            ))
          }
        </h3>
        <div class="sny-founders-grid">
          {
            snyFounders.map((founder, index) => (
              <article class="sny-founder-card glow-card" data-reveal style={`--i: ${index}`}>
                <h4>{founder.name}</h4>
                <p class="sny-founder-school">{founder.school}</p>
                <p>{founder.bio}</p>
                {founder.linkedin && (
                  <a
                    class="sny-founder-linkedin"
                    href={founder.linkedin}
                    target="_blank"
                    rel="noopener noreferrer me"
                  >
                    LinkedIn <span aria-hidden="true">→</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    import { scrambleOnHover, jumbleLetters, decodeLetters } from "../lib/scramble";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const experienceItems = Array.from(
      document.querySelectorAll<HTMLElement>(".experience-item"),
    );

    const revealAllExperienceItems = () => {
      for (const item of experienceItems) {
        item.classList.add("is-visible");
      }
    };

    if (experienceItems.length > 0) {
      if (reduceMotion.matches || !("IntersectionObserver" in window)) {
        revealAllExperienceItems();
      } else {
        const experienceObserver = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.22, rootMargin: "0px 0px -8% 0px" },
        );

        experienceItems.forEach((item, index) => {
          item.style.transitionDelay = `${Math.min(index * 90, 300)}ms`;
          experienceObserver.observe(item);
        });

        reduceMotion.addEventListener("change", () => {
          if (!reduceMotion.matches) return;
          experienceObserver.disconnect();
          revealAllExperienceItems();
        });
      }
    }

    // Generic scroll reveal for [data-reveal] elements (headings,
    // paragraphs, card-grid items). --i (set inline per item) staggers
    // a group's entrance via a CSS transition-delay. Where the browser
    // supports native scroll-driven animations, the matching
    // @supports (animation-timeline: view()) rule in global.css drives
    // this directly off scroll position instead — skip the observer
    // entirely there so only one reveal mechanism runs.
    const supportsViewTimeline = "CSS" in window && CSS.supports("animation-timeline: view()");
    const revealItems = supportsViewTimeline
      ? []
      : Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));

    const revealAll = () => {
      for (const item of revealItems) item.classList.add("is-visible");
    };

    if (revealItems.length > 0) {
      if (reduceMotion.matches || !("IntersectionObserver" in window)) {
        revealAll();
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.2, rootMargin: "0px 0px -8% 0px" },
        );

        for (const item of revealItems) revealObserver.observe(item);

        reduceMotion.addEventListener("change", () => {
          if (!reduceMotion.matches) return;
          revealObserver.disconnect();
          revealAll();
        });
      }
    }

    // Count-up animation for [data-count] stat values (e.g. "75%+", "4.7").
    // Parses the leading numeric portion and animates toward it, keeping
    // the original suffix and decimal precision.
    const countEls = Array.from(document.querySelectorAll<HTMLElement>("[data-count]"));

    const animateCount = (el: HTMLElement) => {
      const raw = el.dataset.count ?? "";
      const match = raw.match(/^([\d.]+)(.*)$/);
      if (!match) {
        el.textContent = raw;
        return;
      }
      const [, numStr, suffix] = match;
      const target = parseFloat(numStr);
      const decimals = numStr.includes(".") ? numStr.split(".")[1].length : 0;
      if (reduceMotion.matches || Number.isNaN(target)) {
        el.textContent = raw;
        return;
      }

      const duration = 1200;
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = target * eased;
        el.textContent = `${value.toFixed(decimals)}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    if (countEls.length > 0) {
      if (reduceMotion.matches || !("IntersectionObserver" in window)) {
        for (const el of countEls) el.textContent = el.dataset.count ?? "";
      } else {
        const countObserver = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              animateCount(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.4 },
        );

        for (const el of countEls) countObserver.observe(el);
      }
    }

    // Typewriter intro line above the hero title.
    const typewriterEl = document.querySelector<HTMLElement>("[data-typewriter]");
    if (typewriterEl) {
      const full = typewriterEl.dataset.typewriter ?? "";
      if (reduceMotion.matches) {
        typewriterEl.textContent = full;
        typewriterEl.classList.add("is-done");
      } else {
        typewriterEl.classList.add("is-typing");
        let i = 0;
        const step = () => {
          i += 1;
          typewriterEl.textContent = full.slice(0, i);
          if (i < full.length) {
            setTimeout(step, 34);
          } else {
            typewriterEl.classList.remove("is-typing");
            typewriterEl.classList.add("is-done");
          }
        };
        setTimeout(step, 260);
      }
    }

    // Hero title scramble/decode. Starts pre-jumbled (random letters, same
    // monospace positions — nothing reflows) so it reads as encrypted
    // until the first hover decodes it, which gets a one-off flourish on
    // top of the usual settle. Every hover after that just replays the
    // normal decode (same scrambleOnHover used everywhere else).
    const heroTitleEl = document.querySelector<HTMLElement>("#hero-title");
    if (heroTitleEl && !reduceMotion.matches) {
      const letters = Array.from(heroTitleEl.querySelectorAll<HTMLElement>(".hero-letter"));
      jumbleLetters(letters);

      let hasUnjumbled = false;
      scrambleOnHover(heroTitleEl, letters, () => {
        if (hasUnjumbled) return;
        hasUnjumbled = true;
        heroTitleEl.classList.add("hero-title--flourish");
        heroTitleEl.addEventListener(
          "animationend",
          () => heroTitleEl.classList.remove("hero-title--flourish"),
          { once: true },
        );
      });
    }

    // Small "boot sequence" echo of the hero title at the end of the bio:
    // jumbled at rest, then auto-decodes once the moment it scrolls into
    // view (a guaranteed payoff, not just a hover easter egg), and stays
    // replayable on hover afterward.
    const signoffEl = document.querySelector<HTMLElement>("#about-signoff");
    if (signoffEl && !reduceMotion.matches) {
      const signoffLetters = Array.from(
        signoffEl.querySelectorAll<HTMLElement>(".about-signoff__letter"),
      );
      jumbleLetters(signoffLetters);
      scrambleOnHover(signoffEl, signoffLetters, () => {
        signoffEl.classList.add("is-decoded");
      });

      if ("IntersectionObserver" in window) {
        const signoffObserver = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              observer.unobserve(entry.target);
              setTimeout(() => {
                decodeLetters(signoffLetters, () => signoffEl.classList.add("is-decoded"));
              }, 500);
            }
          },
          { threshold: 0.6 },
        );
        signoffObserver.observe(signoffEl);
      }
    }
  </script>
