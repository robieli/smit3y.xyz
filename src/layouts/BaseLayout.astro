---
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import "../styles/global.css";

interface Props {
  fullBleed?: boolean;
  showChrome?: boolean;
  title: string;
}

const { title, fullBleed = false, showChrome = true } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var t = localStorage.getItem("theme");
        if (t === "light") html.setAttribute("data-theme", "light");
        else if (t !== "dark" && window.matchMedia("(prefers-color-scheme: light)").matches) {
          html.setAttribute("data-theme", "light");
        }
        var p = localStorage.getItem("palette");
        if (!p) html.setAttribute("data-palette", "solar");
        else if (p !== "midnight") html.setAttribute("data-palette", p);
        if (p === "custom") {
          try {
            var c = JSON.parse(localStorage.getItem("custom-palette") || "{}");
            if (c.accent && c.g1 && c.g2 && c.g3) {
              var s = html.style;
              s.setProperty("--c-accent", c.accent);
              s.setProperty("--c-g1", c.g1);
              s.setProperty("--c-g2", c.g2);
              s.setProperty("--c-g3", c.g3);
            }
          } catch (e) {}
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="mobile-gate" role="alert">
      <div class="mobile-gate__frame">
        <svg
          class="mobile-gate__icon"
          viewBox="0 0 48 36"
          fill="none"
          aria-hidden="true"
        >
          <rect x="1" y="1" width="46" height="28" rx="2" stroke="currentColor" stroke-width="2" />
          <line x1="17" y1="35" x2="31" y2="35" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="24" y1="29" x2="24" y2="35" stroke="currentColor" stroke-width="2" />
          <line x1="9" y1="10" x2="39" y2="10" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
          <line x1="9" y1="15" x2="30" y2="15" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
          <line x1="9" y1="20" x2="34" y2="20" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
        </svg>
        <span class="mobile-gate__prompt">&gt; access_check --viewport</span>
        <h1 class="mobile-gate__title">Desktop Only</h1>
        <p class="mobile-gate__body">
          smit3y.xyz is built for a wider canvas. Pull it up on a laptop
          or desktop browser for the full experience.
        </p>
        <span class="mobile-gate__cursor" aria-hidden="true"></span>
      </div>
    </div>
    <div class="blueprint-grid" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="grain-overlay" aria-hidden="true"></div>
    <canvas class="cursor-trail" aria-hidden="true"></canvas>
    {showChrome && <NavBar />}
    <main
      class={fullBleed
        ? "w-full flex-1"
        : "mx-auto w-full max-w-4xl flex-1 px-6 py-10"}
    >
      <slot />
    </main>
    {showChrome && <Footer />}
  </body>
</html>

<style>
  .mobile-gate {
    display: none;
  }

  @media (max-width: 760px) {
    body {
      overflow: hidden;
    }

    .mobile-gate {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.5rem;
      background: var(--bg-0);
      color: var(--text-lead);
      text-align: center;
    }

    .mobile-gate__frame {
      display: flex;
      max-width: 22rem;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }

    .mobile-gate__icon {
      width: 3rem;
      height: 2.25rem;
      color: var(--accent-light);
    }

    .mobile-gate__prompt {
      font-family: Inconsolata, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      color: var(--text-dim);
    }

    .mobile-gate__title {
      margin: 0;
      background: var(--gradient-hero);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      font-family: Inconsolata, monospace;
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .mobile-gate__body {
      margin: 0;
      color: var(--text-dim);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .mobile-gate__cursor {
      display: inline-block;
      width: 0.6rem;
      height: 1.1rem;
      background: var(--accent-light);
      animation: mobile-gate-blink 1s steps(1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-gate__cursor {
        animation: none;
      }
    }
  }

  @keyframes mobile-gate-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }
</style>
