---
import { Image } from "astro:assets";
import basketball from "../assets/basketball.jpeg";
import coinbase from "../assets/coinbase.png";
import desert from "../assets/desert.jpeg";
import radio from "../assets/radio.jpeg";
import headshot from "../assets/smit3y.jpg";
import bass from "../assets/about-bass.jpg";
import coastal from "../assets/about-coastal.jpg";
import snowAngels from "../assets/about-snowangels.jpg";
import overlook from "../assets/about-overlook.jpg";
import chalk from "../assets/about-chalk.jpg";
import hiking from "../assets/about-hiking.jpg";

// Carousel order (mobile). Landscape: basketball, coinbase. Portrait: desert, radio.
const slides = [
  { src: basketball, alt: "Eli playing basketball" },
  { src: coinbase, alt: "Eli at Coinbase" },
  { src: desert, alt: "Eli in the desert" },
  { src: radio, alt: "Eli on the radio" },
];

// Desktop collage: photos scattered and overlapping at varied sizes/rotations,
// each positioned as a % of the collage box (top/left/width) plus a resting
// rotation and stacking order. Values are hand-tuned, not derived from data.
// Headshot uses top: 0 and a width % (both independent of container height),
// so it stays put whenever the container grows taller to fit more tiles.
const photos = [
  { src: headshot, alt: "Eli Robinson", top: 0, left: 2, width: 52, rotate: -3, z: 3 },
  { src: bass, alt: "Eli playing bass", top: 3, left: 46, width: 48, rotate: 6, z: 2 },
  { src: coastal, alt: "Eli on the California coast", top: 24, left: 0, width: 44, rotate: 4, z: 4 },
  { src: snowAngels, alt: "Eli making snow angels", top: 32, left: 40, width: 50, rotate: -6, z: 2 },
  { src: overlook, alt: "Eli at a snowy overlook", top: 54, left: 6, width: 42, rotate: 5, z: 5 },
  { src: chalk, alt: "Eli in front of Sam Smith sidewalk chalk art", top: 60, left: 44, width: 46, rotate: -4, z: 2 },
  { src: hiking, alt: "Eli backpacking through a creek crossing", top: 78, left: 20, width: 44, rotate: 3, z: 6 },
];
---

<div class="about-photos">
  {
    photos.map((photo) => (
      <div
        class="about-photos__item"
        style={{
          "--top": `${photo.top}%`,
          "--left": `${photo.left}%`,
          "--w": `${photo.width}%`,
          "--rot": `${photo.rotate}deg`,
          "--z": photo.z,
        }}
      >
        <Image
          class="about-photos__img"
          src={photo.src}
          alt={photo.alt}
          widths={[280, 560]}
          sizes="18rem"
          loading="lazy"
        />
      </div>
    ))
  }
</div>

<div class="about-carousel">
  <div class="embla" data-embla>
    <div class="embla__viewport">
      <div class="embla__container">
        {
          slides.map((slide) => (
            <div class="embla__slide">
              <Image
                class="embla__img"
                src={slide.src}
                alt={slide.alt}
                widths={[400, 800]}
                sizes="(max-width: 700px) 60vw, 22rem"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
    <button class="embla__btn embla__btn--prev" type="button" aria-label="Previous image">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button class="embla__btn embla__btn--next" type="button" aria-label="Next image">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  type Embla = ReturnType<typeof EmblaCarousel>;

  // The carousel only exists on mobile; the desktop grid replaces it. Init
  // Embla only when the mobile breakpoint is active so no hidden, autoplaying
  // carousel runs (and recomputes on a zero-width element) on desktop.
  const mobile = window.matchMedia("(max-width: 700px)");
  const instances = new Map<Element, Embla>();
  const roots = Array.from(document.querySelectorAll<HTMLElement>("[data-embla]"));

  // Wire buttons once; handlers read the live instance (or no-op when destroyed).
  for (const root of roots) {
    root
      .querySelector(".embla__btn--prev")
      ?.addEventListener("click", () => instances.get(root)?.scrollPrev());
    root
      .querySelector(".embla__btn--next")
      ?.addEventListener("click", () => instances.get(root)?.scrollNext());
  }

  function sync() {
    for (const root of roots) {
      const active = instances.has(root);
      if (mobile.matches && !active) {
        const viewport = root.querySelector<HTMLElement>(".embla__viewport");
        if (!viewport) continue;
        instances.set(
          root,
          EmblaCarousel(viewport, { loop: true }, [
            Autoplay({ delay: 4000, stopOnInteraction: false, stopOnMouseEnter: true }),
          ]),
        );
      } else if (!mobile.matches && active) {
        instances.get(root)?.destroy();
        instances.delete(root);
      }
    }
  }

  sync();
  mobile.addEventListener("change", sync);
</script>

<style>
  /* Desktop: scattered, overlapping collage — varied sizes/rotations, each
     tile positioned via --top/--left/--w/--rot/--z set inline per photo. */
  .about-photos {
    position: relative;
    width: clamp(26rem, 42vw, 34rem);
    aspect-ratio: 5 / 10.5;
  }

  .about-photos__item {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: var(--w);
    aspect-ratio: 1;
    z-index: var(--z);
    overflow: hidden;
    border: 1px solid var(--border-3);
    border-radius: 10px;
    background: var(--bg-img);
    box-shadow:
      var(--shadow-tag),
      0 0 0 1px var(--border-img);
    transform: rotate(var(--rot));
    transform-origin: center;
    transition:
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease,
      border-color 280ms ease;
  }

  .about-photos__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-photos__item:hover {
    z-index: 10;
    border-color: var(--border-tag-hover);
    transform: rotate(calc(var(--rot) * 0.25)) scale(1.1);
  }

  @media (hover: none) {
    .about-photos__item:hover {
      transform: rotate(var(--rot));
    }
  }

  /* The carousel is mobile-only; hidden on desktop. */
  .about-carousel {
    display: none;
    position: relative;
    width: clamp(16.5rem, 28vw, 22rem);
  }

  .embla {
    position: relative;
  }

  .embla__viewport {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--border-3);
    border-radius: 12px;
    background: var(--bg-img);
    box-shadow: 0 0 0 1px var(--border-img);
  }

  .embla__container {
    display: flex;
    height: 100%;
    touch-action: pan-y pinch-zoom;
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    height: 100%;
  }

  .embla__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .embla__btn {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    transform: translateY(-50%);
    border: 1px solid var(--border-4);
    border-radius: 999px;
    background: var(--bg-tag);
    color: var(--text-sub);
    cursor: pointer;
    opacity: 0;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 240ms ease,
      box-shadow 280ms ease,
      border-color 280ms ease,
      background-color 280ms ease,
      color 280ms ease;
    will-change: transform, opacity;
  }

  .embla__btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .embla__btn--prev {
    left: 0.6rem;
  }

  .embla__btn--next {
    right: 0.6rem;
  }

  .about-carousel:hover .embla__btn,
  .about-carousel:focus-within .embla__btn {
    opacity: 1;
  }

  .embla__btn:hover {
    border-color: var(--border-tag-hover);
    background: var(--bg-tag-hover);
    color: var(--text-hover-tag);
    box-shadow: var(--shadow-tag);
  }

  .embla__btn--prev:hover {
    transform: translateY(-50%) translateX(-2px);
  }

  .embla__btn--next:hover {
    transform: translateY(-50%) translateX(2px);
  }

  .embla__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    opacity: 1;
  }

  /* Touch devices lack hover: keep the controls visible. */
  @media (hover: none) {
    .embla__btn {
      opacity: 1;
    }
  }

  @media (max-width: 700px) {
    .about-photos {
      display: none;
    }

    .about-carousel {
      display: block;
      order: 2;
      width: 100%;
      max-width: clamp(14rem, 55vw, 18rem);
    }
  }
</style>
